<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Toolkit/Gwent.uss" />
    <!-- The main menu: Witcher-style entries on the left of the key art (the key art and its title are the scene's) -->
    <ui:VisualElement name="MainMenu" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="Scrim" class="main-menu__scrim" picking-mode="Ignore" />
        <ui:VisualElement name="Entries" class="main-menu__entries">
            <Gwent.UI.MenuEntry name="Item Play" text="Play" />
            <Gwent.UI.MenuEntry name="Item Multiplayer" text="Multiplayer" />
            <Gwent.UI.MenuEntry name="Item Deck builder" text="Deck builder" />
            <Gwent.UI.MenuEntry name="Item How to play" text="How to play" />
            <Gwent.UI.MenuEntry name="Item Settings" text="Settings" />
            <Gwent.UI.MenuEntry name="Item Quit" text="Quit game" />
        </ui:VisualElement>
        <ui:Label name="Note" text="Fan project, not affiliated with CD PROJEKT RED" class="caption main-menu__note" picking-mode="Ignore" />
        <!-- The version and build (MainMenu fills it in), across from the note -->
        <ui:Label name="Build" class="caption main-menu__build" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
