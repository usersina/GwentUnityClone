<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Toolkit/Gwent.uss" />
    <!-- The settings: Audio, Display and Game tabs (their rows are made in SettingsPanel, they depend on the platform) -->
    <ui:VisualElement name="Dimmer" class="dimmer">
        <ui:VisualElement name="Panel" class="panel settings">
            <ui:VisualElement class="settings__header">
                <ui:Label text="Settings" class="heading" />
                <ui:Label name="Hint" text="Esc to close" class="caption" />
            </ui:VisualElement>
            <ui:VisualElement name="Tabs" class="settings__tabs">
                <ui:Button name="Button Audio" text="Audio" class="tab"><ui:VisualElement class="tab__underline" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="Button Display" text="Display" class="tab"><ui:VisualElement class="tab__underline" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="Button Game" text="Game" class="tab"><ui:VisualElement class="tab__underline" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="divider" />
            <ui:VisualElement name="Pages" class="settings__pages">
                <ui:VisualElement name="Audio" />
                <ui:VisualElement name="Display" />
                <ui:VisualElement name="Game" />
            </ui:VisualElement>
            <ui:VisualElement class="settings__footer">
                <Gwent.UI.DialogButton name="Button Reset to defaults" text="Reset to defaults" class="button--ghost settings__reset" />
                <Gwent.UI.DialogButton name="Button Back" text="Back" class="button--secondary settings__back" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
